// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  marketing
  customer
}

enum StatusUser {
  active
  inactive
}

enum StatusReferral {
  pending
  completed
}

model RateLimitCounter {
  key        String   @id
  hits       Int      @default(0)
  expires_at DateTime

  @@index([expires_at])
}

model User {
  user_id                    String     @id @default(uuid())
  email                      String     @unique
  username                   String     @unique
  password_hash              String
  phone                      String?    @unique
  role                       Role       @default(marketing)
  email_verification_token   String?
  email_verification_expires DateTime?
  email_verified             Boolean    @default(false)
  referral_code              String?    @unique
  no_referensi               String?    @unique
  phone_verified             Boolean    @default(false)
  status                     StatusUser @default(inactive)
  created_at                 DateTime   @default(now())
  updated_at                 DateTime   @updatedAt

  referral_program    ReferralProgram?
  customer            Customer?          @relation("UserToCustomer")
  created_customers   Customer[]         @relation("CreatedBy")
  updated_customers   Customer[]         @relation("LastUpdatedBy")
  admin_activity_logs AdminActivityLog[]
  referrals_made      Referral[]         @relation("Referrer")
  received_referrals  Referral[]         @relation("Referred")
}

model AdminActivityLog {
  activity_id   String   @id @default(uuid())
  actor_user_id String?
  actor_role    String?
  action        String
  entity_type   String
  entity_id     Int?
  before        Json?
  after         Json?
  metadata      Json?
  ip_address    String?
  user_agent    String?
  created_at    DateTime @default(now())

  actor User? @relation(fields: [actor_user_id], references: [user_id])

  @@index([actor_user_id])
  @@index([action])
  @@index([entity_type, entity_id])
  @@index([created_at])
}

model ReferralProgram {
  referral_id    String   @id @default(uuid())
  owner_referral String   @unique
  expires_at     DateTime
  point_reward   Int
  point_given    Int
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user      User?      @relation(fields: [owner_referral], references: [user_id])
  referrals Referral[]
}

model Referral {
  referral_id         String         @id @default(uuid())
  referral_program_id String
  referrer_id         String
  referred_id         String
  point_awarded       Int
  status              StatusReferral @default(pending)
  created_at          DateTime       @default(now())

  program  ReferralProgram @relation(fields: [referral_program_id], references: [referral_id])
  referrer User            @relation("Referrer", fields: [referrer_id], references: [user_id])
  referred User            @relation("Referred", fields: [referred_id], references: [user_id])

  @@index([referrer_id])
}

model Customer {
  customer_id               String    @id @default(uuid())
  user_id                   String    @unique
  runchise_id               Int?      @unique
  runchise_location_id      Int?
  runchise_synced_at        DateTime?
  name                      String
  phone_number              String?
  normalized_phone_number   String?
  phone_number_country_code Int       @default(62)
  address                   String?   @db.Text
  province                  String?
  city                      String?
  country                   String?
  postal_code               String?
  dob                       DateTime? @db.Date
  gender                    String? // male | female | unknown
  status                    String? // active | inactive
  balance                   Decimal   @default(0.0) @db.Decimal(12, 2) // Menggunakan Decimal untuk financial safety
  member_since              DateTime? @db.Date
  total_point               Int       @default(0)
  available_point           Int       @default(0)
  owner_location_id         String?
  created_by_id             String?
  last_updated_by_id        String?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  // Relations
  user            User      @relation("UserToCustomer", fields: [user_id], references: [user_id])
  owner_location  Location? @relation(fields: [owner_location_id], references: [location_id])
  created_by      User?     @relation("CreatedBy", fields: [created_by_id], references: [user_id])
  last_updated_by User?     @relation("LastUpdatedBy", fields: [last_updated_by_id], references: [user_id])

  point_history     PointHistory[]
  sale_transactions SaleTransaction[]

  @@index([phone_number])
  @@index([normalized_phone_number])
  @@index([runchise_location_id])
  @@index([created_at])
}

// ───────────────────────────────────────────────
// BRAND & LOCATIONS
// ───────────────────────────────────────────────

model SubBrand {
  sub_brand_id           String   @id @default(uuid())
  runchise_id            Int      @unique
  name                   String
  image_url              String?
  location_type          String?
  is_select_all_location Boolean  @default(false)
  enable_online_order    Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt
}

model Location {
  location_id      String   @id @default(uuid())
  runchise_id      Int?     @unique
  name             String
  shipping_address String?
  city             String?
  postal_code      String?
  province         String?
  country          String?
  contact_number   String?
  status           String?
  branch_type      String?
  gmap_address     String?  @db.Text
  longitude        String?
  latitude         String?
  sub_brands       String[]
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  customers Customer[]
}

model MenuCategory {
  id         String  @id @default(uuid())
  name       String
  sort_order Int     @default(0)
  is_active  Boolean @default(true)

  @@index([name])
}

model PointHistory {
  id                   String   @id @default(uuid())
  customer_id          String
  reward_redemption_id Int?
  points_change        Int // positif = earn, negatif = redeem
  type                 String // earn | redeem | bonus
  description          String?
  created_at           DateTime @default(now())

  customer Customer @relation(fields: [customer_id], references: [customer_id])
}

model RewardsCatalog {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?  @db.Text
  points_required Int
  image_url       String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

model Promo {
  id                     String    @id @default(uuid())
  runchise_id            Int
  name                   String
  status                 String?
  start_date             String?
  end_date               String?
  channel                String?
  is_online_only         Boolean   @default(false)
  is_all_outlets         Boolean   @default(false)
  locations              Json?
  discount_amount        Decimal?  @db.Decimal(12, 2)
  discount_is_percentage Boolean   @default(false)
  template               String?
  sub_brand              String?
  is_pos_channel         Boolean   @default(false)
  is_visible             Boolean   @default(true)
  start_at               DateTime?
  raw                    Json?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  @@index([is_visible])
  @@index([start_at])
  @@index([is_visible, start_at])
}

model SaleTransaction {
  transaction_id                String    @id @default(uuid())
  customer_id                   String
  location_id                   String
  runchise_id                   Int?      @unique
  runchise_brand_id             Int?
  runchise_sales_no             String?
  runchise_customer_id          Int?
  runchise_location_id          Int?
  gross_sales                   Float?
  net_sales                     Float?
  location_name                 String?
  order_type_name               String?
  subtotal                      Float?
  net_sales_after_tax           Float?
  sales_time                    DateTime?
  note                          String?
  applied_promos_redeemed_point Int?
  loyalty_discount_fee          Float?
  created_at                    DateTime?
  updated_at                    DateTime?

  customer Customer @relation(fields: [customer_id], references: [customer_id])
}

model Token {
  token_id      String   @id @default(uuid())
  token_code    String   @unique
  token_type    String
  access_token  String?
  refresh_token String?
  expires_at    DateTime
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model LoyaltyProduct {
  loyalty_product_id            String    @id   @default(uuid())
  runchise_loyalty_product_id   Int       @unique
  runchise_product_id           Int
  point_needed                  Int
  product_name                  String
  product_sku                   String
  product_description           String?
  product_image_url             String?
  product_unit_name             String?
  max_redeem                    Int
  is_select_all_location        Boolean
  location_ids                  String[]
  product_location_ids          String[]
  created_at                    DateTime @default(now())
  updated_at                    DateTime  @updatedAt
}

model Promo {
  
}
