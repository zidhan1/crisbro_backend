// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────────────────────────
// AUTH
// ───────────────────────────────────────────────

model User {
  id            Int      @id @default(autoincrement())
  email         String?   @unique // Di DBML: not null, unique
  password_hash String
  phone_number  String? @unique // Di DBML: boleh null, unique
  role          String // admin | staff | customer
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  sessions          Session[]
  customer          Customer?  @relation("UserToCustomer")
  created_customers Customer[] @relation("CreatedBy")
  updated_customers Customer[] @relation("LastUpdatedBy")
}

model Session {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])
}

// ───────────────────────────────────────────────
// CUSTOMERS
// ───────────────────────────────────────────────

model Customer {
  id                        Int       @id @default(autoincrement())
  user_id                   Int       @unique
  runchise_id               Int?
  name                      String
  phone_number              String?
  phone_number_country_code Int       @default(62)
  address                   String?   @db.Text
  province                  String?
  city                      String?
  country                   String?
  postal_code               String?
  dob                       DateTime? @db.Date
  gender                    String? // male | female | unknown
  status                    String? // active | inactive
  balance                   Decimal   @default(0.0) @db.Decimal(12, 2) // Menggunakan Decimal untuk financial safety
  member_since              DateTime? @db.Date
  brand_id                  Int
  owner_location_id         Int?
  created_by_id             Int?
  last_updated_by_id        Int?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  // Relations
  user            User      @relation("UserToCustomer", fields: [user_id], references: [id])
  brand           Brand     @relation(fields: [brand_id], references: [id])
  owner_location  Location? @relation("OwnerLocation", fields: [owner_location_id], references: [id])
  created_by      User?     @relation("CreatedBy", fields: [created_by_id], references: [id])
  last_updated_by User?     @relation("LastUpdatedBy", fields: [last_updated_by_id], references: [id])

  customer_locations CustomerLocation[]
  customer_point     CustomerPoint?
  point_histories    PointHistory[]
  redemptions        RewardRedemption[]

  @@index([phone_number])
  @@index([runchise_id])
}

// ───────────────────────────────────────────────
// BRAND & LOCATIONS
// ───────────────────────────────────────────────

model Brand {
  id          Int      @id @default(autoincrement())
  runchise_id Int?
  name        String
  tagline     String?
  logo_url    String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  customers       Customer[]
  locations       Location[]
  menu_categories MenuCategory[]
  menu_items      MenuItem[]
  rewards_catalog RewardsCatalog[]
  sub_brands      SubBrand[]
}

model SubBrand {
  id                     Int      @id @default(autoincrement())
  runchise_id            Int      @unique
  brand_id               Int
  name                   String
  image_url              String?
  location_type          String?
  is_select_all_location Boolean  @default(false)
  enable_online_order    Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  brand              Brand                     @relation(fields: [brand_id], references: [id])
  product_categories SubBrandProductCategory[]
}

model Location {
  id          Int      @id @default(autoincrement())
  brand_id    Int
  runchise_id Int? // null = outlet pusat milik brand
  name        String
  address     String?  @db.Text
  city        String?
  province    String?
  phone       String?
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  is_active   Boolean  @default(true)
  is_outlet   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  brand              Brand              @relation(fields: [brand_id], references: [id])
  customer_locations CustomerLocation[]
  owned_customers    Customer[]         @relation("OwnerLocation")
}

model CustomerLocation {
  id          Int @id @default(autoincrement())
  customer_id Int
  location_id Int

  customer Customer @relation(fields: [customer_id], references: [id])
  location Location @relation(fields: [location_id], references: [id])
}

// ───────────────────────────────────────────────
// MENU
// ───────────────────────────────────────────────

model MenuCategory {
  id         Int     @id @default(autoincrement())
  brand_id   Int
  name       String // Semua | Katsu | Paket | Minuman
  sort_order Int     @default(0)
  is_active  Boolean @default(true)

  brand            Brand                     @relation(fields: [brand_id], references: [id])
  items            MenuItem[]
  sub_brand_links  SubBrandProductCategory[]

  @@index([name])
}

model SubBrandProductCategory {
  id               Int @id @default(autoincrement())
  sub_brand_id     Int
  menu_category_id Int

  sub_brand     SubBrand     @relation(fields: [sub_brand_id], references: [id])
  menu_category MenuCategory @relation(fields: [menu_category_id], references: [id])

  @@unique([sub_brand_id, menu_category_id])
  @@index([sub_brand_id])
  @@index([menu_category_id])
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  brand_id    Int
  runchise_id Int?     @unique
  category_id Int
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  image_url   String?
  badge       String? // Best Seller | Pedas | Baru etc.
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  brand    Brand        @relation(fields: [brand_id], references: [id])
  category MenuCategory @relation(fields: [category_id], references: [id])
  redeem_menu_items RedeemMenuItem[]

  @@index([brand_id])
  @@index([category_id])
  @@index([is_active])
}

model RedeemMenuCategory {
  id         Int      @id @default(autoincrement())
  name       String
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  items RedeemMenuItem[]

  @@index([is_active])
  @@index([sort_order])
}

model RedeemMenuItem {
  id                 Int       @id @default(autoincrement())
  menu_item_id       Int
  category_id        Int
  points_required    Int
  is_active          Boolean   @default(true)
  badge              String?
  sort_order         Int       @default(0)
  start_at           DateTime?
  end_at             DateTime?
  stock_limit        Int?
  daily_limit        Int?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  menu_item MenuItem           @relation(fields: [menu_item_id], references: [id])
  category  RedeemMenuCategory @relation(fields: [category_id], references: [id])

  @@unique([menu_item_id])
  @@index([category_id])
  @@index([is_active])
  @@index([sort_order])
}

// ───────────────────────────────────────────────
// POINTS & REWARDS
// ───────────────────────────────────────────────

model CustomerPoint {
  id                    Int      @id @default(autoincrement())
  customer_id           Int      @unique
  total_point           Int      @default(0)
  available_point       Int      @default(0)
  next_reward_threshold Int      @default(2000)
  updated_at            DateTime @updatedAt

  customer Customer @relation(fields: [customer_id], references: [id])
}

model PointHistory {
  id                   Int      @id @default(autoincrement())
  customer_id          Int
  reward_redemption_id Int?
  points_change        Int // positif = earn, negatif = redeem
  type                 String // earn | redeem | bonus
  description          String?
  created_at           DateTime @default(now())

  customer          Customer          @relation(fields: [customer_id], references: [id])
  reward_redemption RewardRedemption? @relation(fields: [reward_redemption_id], references: [id])
}

model RewardsCatalog {
  id              Int      @id @default(autoincrement())
  brand_id        Int
  name            String
  description     String?  @db.Text
  points_required Int
  image_url       String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  brand       Brand              @relation(fields: [brand_id], references: [id])
  redemptions RewardRedemption[]
}

model Promo {
  id                     Int      @id @default(autoincrement())
  runchise_id            Int      @unique
  name                   String
  status                 String?
  start_date             String?
  end_date               String?
  channel                String?
  is_online_only         Boolean  @default(false)
  is_all_outlets         Boolean  @default(false)
  locations              Json?
  discount_amount        Decimal? @db.Decimal(12, 2)
  discount_is_percentage Boolean  @default(false)
  template               String?
  sub_brand              String?
  is_pos_channel         Boolean  @default(false)
  is_visible             Boolean  @default(true)
  start_at               DateTime?
  raw                    Json?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  @@index([is_visible])
  @@index([start_at])
  @@index([is_visible, start_at])
}

model RewardRedemption {
  id              Int       @id @default(autoincrement())
  customer_id     Int
  reward_id       Int
  points_spent    Int
  status          String // pending | claimed | expired
  redemption_code String?   @unique
  redeemed_at     DateTime?

  customer        Customer       @relation(fields: [customer_id], references: [id])
  reward          RewardsCatalog @relation(fields: [reward_id], references: [id])
  point_histories PointHistory[]
}
