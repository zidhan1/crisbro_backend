{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/runchise-sync/locations",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/runchise-sync/brands",
      "schedule": "5 12 * * *"
    },
    {
      "path": "/api/cron/runchise-sync/products",
      "schedule": "10 12 * * *"
    },
    {
      "path": "/api/cron/runchise-sync/customers",
      "schedule": "15,45 12 * * *"
    },
    {
      "path": "/api/cron/runchise-sync/sales-transactions",
      "schedule": "20 12 * * *"
    },
    {
      "path": "/api/cron/runchise-sync/promos",
      "schedule": "25 12 * * *"
    },
    {
      "path": "/api/cron/runchise-sync/points",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron/runchise-sync/customer-timestamps-worker",
      "schedule": "35 12 * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "45 12 * * *"
    }
  ]
}
