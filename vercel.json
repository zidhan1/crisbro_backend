{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/runchise-sync/master",
      "schedule": "0 12,18 * * *"
    },
    {
      "path": "/api/cron/runchise-sync/points",
      "schedule": "*/30 * * * *"
    }
  ]
}
